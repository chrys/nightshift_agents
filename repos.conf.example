# ==============================================================================
# Nightly Prompts Sweep Configuration
# Copy this file to repos.conf and configure your repositories and engine.
# ==============================================================================

# Global Default AI Engine
# Supported options:
#   - agy      (Google Antigravity CLI)
#   - claude   (Anthropic Claude Code CLI)
#   - opencode (OpenCode CLI)
ENGINE="agy"

# Repositories to scan every night (must contain a .git directory).
# You can optionally specify a destination branch and/or engine override:
#   - "/path/to/repo"                  (auto-detected default branch & global engine)
#   - "/path/to/repo:branch"           (targets custom branch, e.g. ':develop' or ':main')
#   - "/path/to/repo:engine"           (overrides engine, e.g. ':claude')
#   - "/path/to/repo:branch:engine"    (targets custom branch AND custom engine)
# Example:
#   "$HOME/Projects/my-app:main"
#   "$HOME/Projects/my-service:develop"
#   "$HOME/Projects/legacy-app:main:claude"
REPOS=(
  "$HOME/Projects/my-first-repo:main"
  "$HOME/Projects/my-second-repo:develop"
)

# ------------------------------------------------------------------------------
# Model Schedules (Weekday vs Sunday Deep Reasoning)
# ------------------------------------------------------------------------------

# Antigravity (agy) Models
AGY_WEEKDAY_MODEL="Gemini 3.8 Flash (High)"
AGY_SUNDAY_MODEL="Gemini 4 Argon (Medium)"

# Claude Code Models (Leave empty to use Claude Code default)
CLAUDE_WEEKDAY_MODEL=""
CLAUDE_SUNDAY_MODEL=""

# OpenCode Models (Leave empty to use OpenCode default)
OPENCODE_WEEKDAY_MODEL=""
OPENCODE_SUNDAY_MODEL=""

# Default base branch if git auto-detection fails
DEFAULT_BASE_BRANCH="main"

# ------------------------------------------------------------------------------
# Quality & Review Controls
# ------------------------------------------------------------------------------

# Maximum open unmerged PRs per repo before pausing new nightly sweeps (0 to disable)
MAX_OPEN_PRS=3

# Optional verification test command (e.g., "pytest -q" or "npm test").
# If specified, the sweep runs this before opening a PR; failing tests discard the branch.
TEST_COMMAND=""
